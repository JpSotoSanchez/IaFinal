{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1e56e703c17c48859123a3034fb18830",
    "m_Group": {
        "m_Id": "22bddfb2233443a4b3a7e32b6c3b51bb"
    },
    "m_Name": "TramaCopia",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1500.0,
            "y": -400.0,
            "width": 234.9999542236328,
            "height": 93.99998474121094
        }
    },
    "m_Slots": [
        {
            "m_Id": "dc0c873dbb824166bcda1ed860e13355"
        },
        {
            "m_Id": "a19946d7fe624ef4951d984fe13ca21d"
        },
        {
            "m_Id": "f69ac9c06b8d47e5ab655c1181026296"
        },
        {
            "m_Id": "07c20a6a95204ed09868b30e8c1854b7"
        },
        {
            "m_Id": "8058718578194b378bdd3bf751619c04"
        },
        {
            "m_Id": "4b7874136b3c48a2a0d7e6f1effbedaf"
        },
        {
            "m_Id": "e914fc7acc09451492ff0bcf0f0c879d"
        },
        {
            "m_Id": "e0e1576782724212acf8822531e1482a"
        },
        {
            "m_Id": "62a1f93303264b48990d8916bba9abb3"
        },
        {
            "m_Id": "a20884bb82a241bb9d505d3aeb4ed50c"
        },
        {
            "m_Id": "e322ee301ead44e2a25c32e5ae17c3e9"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TramaCopia",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 q = Pixel.xy / max(Tamano, 1.0);\nfloat t;\nif (Patron < 0.5)          // puntos halftone en rejilla a 45\u00b0\n{\n    float2 r = float2(q.x + q.y, q.x - q.y) * 0.70710678;\n    t = step(length(frac(r) - 0.5), Densidad * 0.70710678);\n}\nelse if (Patron < 1.5)     // l\u00edneas diagonales\n{\n    t = step(frac((q.x + q.y) * 0.5), Densidad);\n}\nelse                       // Bayer 4x4\n{\n    float bayer[16] = {0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5};\n    uint2 b = (uint2)fmod(floor(q), 4.0);\n    t = step((bayer[b.y * 4 + b.x] + 0.5) / 16.0, Densidad);\n}\n// mismo \"\u00bfhay glitch en este cuadro?\" que GlitchFranjas\nfloat activo = step(1.0 - Probabilidad, frac(sin(floor(Tiempo * FPS) * 12.9898 + 4.1) * 43758.5453));\nfloat visible = lerp(1.0, activo, SoloConGlitch);\nTrama = t;\nAlpha = visible * lerp(1.0, t, Recortar);"
}


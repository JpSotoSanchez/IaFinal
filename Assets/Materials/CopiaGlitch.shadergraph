{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "339bfdcbfebb43fd82767529cb381323",
    "m_Title": "",
    "m_Content": "Onda: la banda sube por el objeto entre Altura Min y Altura Max (espacio objeto; esfera/cubo de Unity = -0.5..0.5, c\u00e1psula = -1..1) y empuja los v\u00e9rtices hacia afuera. Inflado Suave = 1 empuja desde el centro (las esquinas repetidas de aristas duras se mueven juntas: sin huecos); 0 = por la normal. Ondulacion a\u00f1ade un anillo hacia dentro. Se ve mejor con mallas con suficientes v\u00e9rtices (esfera, modelo).",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3350.0,
        "y": 2750.0,
        "width": 460.0,
        "height": 120.0
    },
    "m_Group": {
        "m_Id": "289a174c4cf040e588a7bc3d0df6def9"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3bb8672caf28459e9385b338745db513",
    "m_Title": "",
    "m_Content": "Jitter PS1: cada v\u00e9rtice se redondea a una rejilla de \"Resolucion Jitter\" p\u00edxeles verticales en pantalla y se regresa a espacio objeto. No se aplica en la sombra ni en la preview de Shader Graph.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2500.0,
        "y": 2950.0,
        "width": 420.0,
        "height": 90.0
    },
    "m_Group": {
        "m_Id": "289a174c4cf040e588a7bc3d0df6def9"
    }
}


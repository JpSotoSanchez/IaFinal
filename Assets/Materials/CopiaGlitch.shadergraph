{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "5764054dbaf74714b47d30c6d1270e0e",
    "m_Group": {
        "m_Id": "289a174c4cf040e588a7bc3d0df6def9"
    },
    "m_Name": "OndaRefresco",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2900.0,
            "y": 2000.0,
            "width": 234.9999542236328,
            "height": 93.99998474121094
        }
    },
    "m_Slots": [
        {
            "m_Id": "9ce896d826b740b7a5020f806900157a"
        },
        {
            "m_Id": "f334182c234e49a2826947c9958838b7"
        },
        {
            "m_Id": "d61c568f46be43d98646e62dc78d7c8b"
        },
        {
            "m_Id": "ca40ce2188a74fa4b5f92bad412041e8"
        },
        {
            "m_Id": "3fdc383630dc4139b03c458ef2764c2b"
        },
        {
            "m_Id": "8bf544bf466b4d7bb797d9964a5cb97f"
        },
        {
            "m_Id": "17b1d2829ecb470d99e9f2f35df2973b"
        },
        {
            "m_Id": "1da60c3d8cac4397a3ef69a879fd7fbe"
        },
        {
            "m_Id": "e9c132ec5f92451a9624bb7ceb1c981d"
        },
        {
            "m_Id": "c510a459dc53489f9afe8d78c282d076"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "OndaRefresco",
    "m_FunctionSource": "",
    "m_FunctionBody": "float y = (PosOS.y - DesplazY - AlturaMin) / max(AlturaMax - AlturaMin, 1e-4);\nfloat a = max(Ancho, 1e-3);\n// el centro va de -ancho a 1+ancho: la banda entra y sale completa del objeto\nfloat centro = lerp(-a, 1.0 + a, frac(Tiempo * Velocidad));\nfloat d = (y - centro) / a;                 // -1..1 dentro de la banda\nfloat b = saturate(1.0 - abs(d));\nb = b * b * (3.0 - 2.0 * b);                // smoothstep\nOnda = b * lerp(1.0, cos(6.2831853 * d), Ondulacion);\nAltura = y;"
}


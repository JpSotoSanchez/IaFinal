    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1836568bba2e4a518868a3d67d8c3ccd",
    "m_Title": "",
    "m_Content": "Patron: 0 = puntos halftone, 1 = l\u00edneas diagonales, 2 = Bayer 4x4 (en p\u00edxeles de Tamano Trama). Recortar Trama = 1 descarta los huecos (la copia queda hecha solo de la trama). Solo Con Glitch = 1: la copia solo aparece cuando el objeto hace glitch.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {

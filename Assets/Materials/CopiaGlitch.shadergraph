{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1b92a66f3bfd418799bde9d3153b553b",
    "m_Group": {
        "m_Id": "97f0272eb25e40a3a24c1d0493e242bb"
    },
    "m_Name": "DesfaseCopia",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1500.0,
            "y": 2000.0,
            "width": 234.9999542236328,
            "height": 93.99998474121094
        }
    },
    "m_Slots": [
        {
            "m_Id": "d14a650b18624514bf4fd20dcaa9ba73"
        },
        {
            "m_Id": "72c4f17c95f54ea1bebf9c1beedb6aad"
        },
        {
            "m_Id": "3d694b3296ca4c50b6619fcc74c5c171"
        },
        {
            "m_Id": "9fafc4c154cc4e7f8e2780669e6364e1"
        },
        {
            "m_Id": "0643e2d4e53b43c7828b67d27e70e48a"
        },
        {
            "m_Id": "06fc423680244ada9c708bfa2f63c3c8"
        },
        {
            "m_Id": "95c615277cbe4599b01bd8f7bb5e842b"
        },
        {
            "m_Id": "4ae7ff8915dd494d976d448ab4db1ec9"
        },
        {
            "m_Id": "4301b2b5b9ec44b0ae3814a8b8888a05"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DesfaseCopia",
    "m_FunctionSource": "",
    "m_FunctionBody": "float3 p = PosOS;\n#if defined(SHADERGRAPH_PREVIEW)\np += NormalOS * GrosorCopia * 5.0;\np.xy += float2(DesfaseX, DesfaseY) * 2.0;\n#else\n// inflar por la direcci\u00f3n suave de VerticesRetro (\u00d7 distancia a c\u00e1mara: grosor parecido de cerca y de lejos)\nfloat dist = distance(GetCameraPositionWS(), TransformObjectToWorld(p));\np += NormalOS * GrosorCopia * dist;\n// desplazar en pantalla: desfase fijo + salto aleatorio que cambia FPSSalto veces por segundo\nfloat4 cs = TransformObjectToHClip(p);\nfloat s = floor(Tiempo * FPSSalto);\nfloat2 azar = frac(sin(float2(s * 12.9898, s * 78.233) + 1.7) * 43758.5453) * 2.0 - 1.0;\nfloat2 desf = float2(DesfaseX, DesfaseY) + azar * Salto;\ndesf.y *= _ProjectionParams.x;               // misma direcci\u00f3n aunque la proyecci\u00f3n est\u00e9 volteada\ncs.xy += desf * 2.0 * cs.w;                  // clip va de -1 a 1: \u00d72 = fracci\u00f3n de pantalla\nfloat4 ws = mul(UNITY_MATRIX_I_VP, cs);\np = TransformWorldToObject(ws.xyz / ws.w);\n#endif\nPosicion = p;"
}


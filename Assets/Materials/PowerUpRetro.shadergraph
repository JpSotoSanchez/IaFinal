            "m_Id": "270340f2c09e4539afae33ef643ed770"
        },
        {
            "m_Id": "a1ce9b601a0d47198729c74b713216ba"
        },
        {
            "m_Id": "997dd2822aed4aa7987b07a5d199f5a5"
        },
        {
            "m_Id": "ed8ab9c0581442929def7b4069367018"
        },
        {
            "m_Id": "253a1837b510499280d5180138eeb873"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GlitchFranjas",
    "m_FunctionSource": "",
    "m_FunctionBody": "float s = floor(Tiempo * FPS);\n// \u00bfhay glitch en este \"cuadro\"? (mismo valor para todo el objeto)\nfloat activo = step(1.0 - Probabilidad, frac(sin(s * 12.9898 + 4.1) * 43758.5453));\nfloat f = floor(Altura * Franjas);\nfloat h = frac(sin(dot(float2(f, s), float2(127.1, 311.7))) * 43758.5453);\n// la mitad de las franjas se mueve, cada una con su desplazamiento (-1..1)\nGlitch = activo * step(0.5, h) * (h * 4.0 - 3.0);"
}


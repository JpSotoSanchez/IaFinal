{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b0ddf40f31064ae090022eb98869af60",
    "m_Group": {
        "m_Id": "fcd064c9179347e1962031c55eb089a4"
    },
    "m_Name": "OndaRefresco",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2900.0,
            "y": 2000.0,
            "width": 234.9999542236328,
            "height": 93.99998474121094
        }
    },
    "m_Slots": [
        {
            "m_Id": "234a75792cba46beb752a766fbd06f4a"
        },
        {
            "m_Id": "7f34078b57d743ebb3938c489f6d2935"
        },
        {
            "m_Id": "d7c528969cf74d41b5bbdb30770319bb"
        },
        {
            "m_Id": "bda928395a0c464fbc47773fc53c1bf7"
        },
        {
            "m_Id": "c5f60145543049d98e5278aa218c40b5"
        },
        {
            "m_Id": "708084e2de1943fa917523e6021e0db8"
        },
        {
            "m_Id": "1fd0085e99a54bd6b0635fd893ca36df"
        },
        {
            "m_Id": "e28e99eaf61f48ffba5c3b0e25e971d2"
        },
        {
            "m_Id": "47a47a979f1844ffbd6868ca9124d979"
        },
        {
            "m_Id": "962833b999ba4fbfb9758168d8d5cac0"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "OndaRefresco",
    "m_FunctionSource": "",
    "m_FunctionBody": "float y = (PosOS.y - DesplazY - AlturaMin) / max(AlturaMax - AlturaMin, 1e-4);\nfloat a = max(Ancho, 1e-3);\n// el centro va de -ancho a 1+ancho: la banda entra y sale completa del objeto\nfloat centro = lerp(-a, 1.0 + a, frac(Tiempo * Velocidad));\nfloat d = (y - centro) / a;                 // -1..1 dentro de la banda\nfloat b = saturate(1.0 - abs(d));\nb = b * b * (3.0 - 2.0 * b);                // smoothstep\nOnda = b * lerp(1.0, cos(6.2831853 * d), Ondulacion);\nAltura = y;"
}


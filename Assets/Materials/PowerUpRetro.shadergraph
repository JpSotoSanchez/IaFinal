    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PaletaBayer",
    "m_FunctionSource": "",
    "m_FunctionBody": "float bayer[16] = {0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5};\nuint2 q = (uint2)fmod(floor(Pixel.xy), 4.0);\nfloat umbral = (bayer[q.y * 4 + q.x] + 0.5) / 16.0;\nfloat n = max(Niveles - 1.0, 1.0);\nOut = floor(Color * n + umbral) / n;"
}

